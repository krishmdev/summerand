# Everything is optional. With nothing set, `summerand demo` replays the recorded fixture with
# local (MiniLM) or hashing embeddings and extractive briefs.

# OpenAI: text-embedding-3-small for embeddings and a chat model for briefs.
OPENAI_API_KEY=
SUMMERAND_EMBEDDER=auto          # auto | openai | local | hashing
SUMMERAND_LLM=auto               # auto | openai | off
SUMMERAND_BRIEF_MODEL=gpt-4.1-mini

# Polygon equities (the stocks WebSocket needs a paid plan; REST minute bars work on free).
POLYGON_API_KEY=
POLYGON_WS_URL=wss://socket.polygon.io/stocks

# CryptoPanic (optional). {token} is filled in from CRYPTOPANIC_TOKEN.
CRYPTOPANIC_TOKEN=
CRYPTOPANIC_URL=https://cryptopanic.com/api/developer/v2/posts/?auth_token={token}&public=true

# Compose / Kafka mode
KAFKA_BROKER=localhost:19092
DATABASE_URL=sqlite:///var/summerand.sqlite
SUMMERAND_API_PORT=8000
SUMMERAND_PG_PORT=5433
